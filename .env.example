# ── BhoomiIntelli OCR Service — Environment Variables ──────────────────────────
#
# Copy this file to .env (never commit .env) and fill in values.
# In Render/Railway, set these directly in the dashboard instead.

# Server port. Render/Railway override this automatically. Default: 8000
PORT=8000

# Comma-separated list of allowed CORS origins.
# Include your live Vercel frontend URLs here once deployed.
# Example:
#   ALLOWED_ORIGINS=https://bhoomi-admin.vercel.app,https://bhoomi-user.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
